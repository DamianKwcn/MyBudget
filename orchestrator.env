SERVER_PORT=3333

SPRING_APPLICATION_NAME=orchestrator

CONFIG_SERVER_URL=http://configserver:8071/

KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9093,kafka3:9094
KAFKA_CONSUMER_GROUP_ID=orchestrator-group
KAFKA_CONSUMER_TRUSTED_PACKAGES=*

EUREKA_INSTANCE_PREFERIPADDRESS=true
EUREKA_CLIENT_FETCHREGISTRY=true
EUREKA_CLIENT_REGISTERWITHEUREKA=true
EUREKA_DEFAULT_ZONE=http://eurekaserver:8070/eureka/
